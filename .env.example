# Copy to .env and fill in the values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=portfolio
# Host port (5432 is often taken by a local Postgres)
POSTGRES_HOST_PORT=5433

# --- n8n ---
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-long-random-string
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=America/Bogota

# Shared secret that callers must send in the "X-Webhook-Token" header.
# Generate with: openssl rand -hex 24
WEBHOOK_TOKEN=change-me-webhook-token

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Notifications ---
# Mattermost incoming webhook (Slack-compatible payload). Created in Mattermost:
# Integrations > Incoming Webhooks > Add. Use the internal host, e.g.
# http://mattermost:8065/hooks/xxxxxxxx
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_TO=sales@example.com
MATTERMOST_URL=http://localhost:8065

# --- Project 1: lead scoring thresholds ---
HOT_LEAD_THRESHOLD=75
WARM_LEAD_THRESHOLD=45

# --- Project 2: max difference allowed when checking invoice math ---
INVOICE_AMOUNT_TOLERANCE=0.05

# --- Project 3: RAG settings ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chunks less similar than this (cosine, 0-1) are ignored; no relevant chunk -> escalate to a human
RAG_MIN_SIMILARITY=0.35
RAG_TOP_K=5

# --- NocoDB (CRM) — filled automatically by scripts/bootstrap.sh ---
NOCODB_API_TOKEN=
NOCODB_LEADS_TABLE_ID=

# --- Admin user created by scripts/bootstrap.sh in n8n, Mattermost and NocoDB (local only) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Portfolio-Demo-2026!
